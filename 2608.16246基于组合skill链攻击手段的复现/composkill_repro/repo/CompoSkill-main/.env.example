# Skill-Combinatorial-Attack — environment variables template.
# Copy this file to .env in the same directory and fill in real values.
# Never commit the real .env file. The .env file is read by msc_llm.py and
# eval_nanobot_baseline.py automatically (via python-dotenv-style parsing).

# =============================================================================
# LLM API credentials — the pipeline calls an OpenAI-compatible chat endpoint.
# Tested with Alibaba Cloud DashScope (Qwen family) and SiliconFlow (DeepSeek,
# Qwen). Any OpenAI-compatible endpoint will work.
# =============================================================================

# Primary LLM API key used by msc_llm.py (Stage 3 chain engine: SCG builder,
# k-SP search, inject) and by build_skill_snapshot.py / build_skill_pools.py.
# Pick ONE of these and fill it in — msc_llm resolves them in this order.
MSC_LLM_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Lower-case alias used by some project scripts (kept for backwards compat).
# Leave this set to the same value as MSC_LLM_API_KEY.
api_key=
base_url=

# =============================================================================
# Stage 2 LLM client (build_skill_pools / generate_hsb_tasks)
# =============================================================================
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen3.6-plus
QWEN_MODEL=qwen3.6-plus

# =============================================================================
# Stage 4 evaluation (eval_nanobot_baseline.py)
# — agent = the model that runs the nanobot agent loop
# — judge = the model that scores attack success
# =============================================================================
NANOBOT_API_KEY=
NANOBOT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
NANOBOT_MODEL=qwen3.6-plus

JUDGE_API_KEY=
JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional concurrency / runtime knobs (defaults shown)
HSB_NUM_THREADS=1
HSB_INTERACTION_TURNS=3
HSB_AUDIT_RETRY_TURNS=1
HSB_JUDGE_RPM=10

# =============================================================================
# Stage 4-OpenClaw (openclaw_runtime/scripts/run_evaluation.py)
# Separate runtime: OpenClaw 2026.4.22 + Python 3.12 venv + Node.js 22.14.
# These use DIFFERENT env-var names from the Nanobot evaluator above — the
# OpenClaw runner reads AGENT_* and JUDGE_* (no NANOBOT_ prefix). Set them
# inside the openclaw_runtime/ shell, not the main .env, OR export both sets.
# See openclaw_runtime/README.md and openclaw_runtime/docs/reproduction.md.
# =============================================================================
AGENT_API_KEY=
AGENT_API_BASE=https://agent-provider.example/v1
AGENT_MODEL=agent-model-id

# JUDGE_API_KEY / JUDGE_API_BASE are shared with the Nanobot block above;
# OpenClaw additionally reads JUDGE_MODEL (the Nanobot evaluator does not).
JUDGE_MODEL=judge-model-id

# Path to the OpenClaw CLI binary installed by `npm install openclaw@2026.4.22`.
# Default is openclaw_runtime/openclaw-2026.4.22/node_modules/.bin/openclaw.
OPENCLAW_CLI=

# =============================================================================
# Stage 4 baseline-B (SkillsGuard scanner) — the LLM used by the FastAPI guard
# service. Configure via Web UI at runtime, NOT via env. These env vars only
# control upload limits / host / port.
# =============================================================================
MAX_UPLOAD_SIZE_MB=50
MAX_CONTENT_CHARS=500000
HOST=0.0.0.0
PORT=7860
