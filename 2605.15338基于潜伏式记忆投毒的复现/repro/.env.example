# --- Model provider credentials (set only the ones your configs use) ---
# OpenRouter-routed models (many subjects + some mem0 managers)
OPENROUTER_API_KEY=sk-or-...
# OpenAI direct (GPT subjects, default graders/judges)
OPENAI_API_KEY=
# Anthropic direct (Claude subjects/managers)
ANTHROPIC_API_KEY=
# Google Gemini direct (Gemini subjects/managers via the native API)
GOOGLE_API_KEY=
# DeepSeek direct (DeepSeek subjects, and the DeepSeek mem0 manager)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Inspect runtime ---
INSPECT_LOG_DIR=./logs
INSPECT_TRACE_FILE=${PWD}/logs/inspect-trace.log
HOME=${PWD}/.inspect_home
INSPECT_EVAL_MAX_CONNECTIONS=5
